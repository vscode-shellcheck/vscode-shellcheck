{
  "editor.tabSize": 2,
  "search.exclude": {
    "out": true,
    "dist": true
  },
  // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
  "typescript.tsc.autoDetect": "off",
  "typescript.tsdk": "./node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "[javascript][typescript][json][jsonc][yaml][yaml][markdown][shellscript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript][typescript]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "go.alternateTools": {
    "go": "${workspaceFolder}/.vscode/mise-tools/go",
    "dlv": "${workspaceFolder}/.vscode/mise-tools/dlv",
    "gopls": "${workspaceFolder}/.vscode/mise-tools/gopls"
  },
  "debug.javascript.defaultRuntimeExecutable": {
    "pwa-node": "${workspaceFolder}/.vscode/mise-tools/node"
  },
  "shellcheck.executablePath": "${workspaceFolder}/.vscode/mise-tools/shellcheck",
  "python.defaultInterpreterPath": "${workspaceFolder}/.vscode/mise-tools/python"
}
