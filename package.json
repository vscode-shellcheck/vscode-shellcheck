{
  "name": "shellcheck",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.45.0",
  "publisher": "timonwong",
  "author": "Timon Wong <timon86.wang@gmail.com> (https://github.com/timonwong)",
  "contributors": [
    "Felipe Santos <felipecassiors@gmail.com> (https://github.com/felipecrs)"
  ],
  "type": "module",
  "license": "MIT",
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "shell",
    "shellscript",
    "linter",
    "lint",
    "sh",
    "bash",
    "dash",
    "ksh",
    "posix",
    "bats"
  ],
  "homepage": "https://github.com/vscode-shellcheck/vscode-shellcheck#readme",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/vscode-shellcheck/vscode-shellcheck.git"
  },
  "bugs": {
    "url": "https://github.com/vscode-shellcheck/vscode-shellcheck/issues"
  },
  "sponsor": {
    "url": "https://github.com/vscode-shellcheck/vscode-shellcheck"
  },
  "icon": "shellcheck.png",
  "activationEvents": [
    "onLanguage:shellscript",
    "onLanguage:bats"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.cjs",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "shellcheck.executablePath"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "snippets": [
      {
        "language": "shellscript",
        "path": "./snippets/snippets.json"
      },
      {
        "language": "bats",
        "path": "./snippets/snippets.json"
      }
    ],
    "languages": [
      {
        "id": "shellcheckrc",
        "extensions": [
          ".shellcheckrc"
        ],
        "configuration": "./languages/shellcheckrc/language-configuration.json"
      },
      {
        "id": "shellcheck-output",
        "configuration": "./languages/shellcheck-output/language-configuration.json"
      },
      {
        "id": "bats",
        "extensions": [
          ".bats"
        ]
      }
    ],
    "grammars": [
      {
        "language": "shellcheckrc",
        "scopeName": "source.shellcheckrc",
        "path": "./languages/shellcheckrc/tmLanguage.json"
      },
      {
        "language": "shellcheck-output",
        "scopeName": "shellcheck-output",
        "path": "./languages/shellcheck-output/tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "shellcheck.runLint",
        "title": "%command.runLint.title%",
        "category": "ShellCheck"
      },
      {
        "command": "shellcheck.collectDiagnostics",
        "title": "%command.collectDiagnostics.title%",
        "category": "ShellCheck"
      },
      {
        "command": "shellcheck.showMenu",
        "title": "%command.showMenu.title%",
        "category": "ShellCheck"
      },
      {
        "command": "shellcheck.useWasmRuntime",
        "title": "%command.useWasmRuntime.title%",
        "category": "ShellCheck"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "shellcheck.useWasmRuntime",
          "when": "!isWeb"
        }
      ]
    },
    "icons": {
      "shellcheck-logo": {
        "description": "%icon.shellcheck-logo.description%",
        "default": {
          "fontPath": "./resources/shellcheck-icons.woff",
          "fontCharacter": "\\E000"
        }
      }
    },
    "configuration": [
      {
        "title": "%config.title%",
        "type": "object",
        "properties": {
          "shellcheck.enable": {
            "description": "%config.enable.description%",
            "type": "boolean",
            "scope": "resource",
            "default": true
          },
          "shellcheck.enableQuickFix": {
            "markdownDescription": "%config.enableQuickFix.markdownDescription%",
            "type": "boolean",
            "scope": "resource",
            "default": true
          },
          "shellcheck.markdownDiagnostics": {
            "markdownDescription": "%config.markdownDiagnostics.markdownDescription%",
            "type": "boolean",
            "scope": "resource",
            "default": false,
            "tags": [
              "experimental"
            ]
          },
          "shellcheck.executablePath": {
            "markdownDescription": "%config.executablePath.markdownDescription%",
            "examples": [
              "shellcheck"
            ],
            "type": "string",
            "scope": "machine-overridable"
          },
          "shellcheck.runtime": {
            "markdownDescription": "%config.runtime.markdownDescription%",
            "type": "string",
            "enum": [
              "native",
              "wasm"
            ],
            "enumDescriptions": [
              "%config.runtime.enumDescriptions.0%",
              "%config.runtime.enumDescriptions.1%"
            ],
            "scope": "window",
            "default": "native",
            "tags": [
              "experimental"
            ]
          },
          "shellcheck.run": {
            "description": "%config.run.description%",
            "type": "string",
            "enum": [
              "onSave",
              "onType",
              "manual"
            ],
            "scope": "resource",
            "default": "onType"
          },
          "shellcheck.exclude": {
            "markdownDescription": "%config.exclude.markdownDescription%",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(SC)?\\d{4}$",
              "patternErrorMessage": "%config.exclude.items.patternErrorMessage%"
            },
            "scope": "resource",
            "default": [],
            "examples": [
              [
                "1017"
              ]
            ]
          },
          "shellcheck.customArgs": {
            "markdownDescription": "%config.customArgs.markdownDescription%",
            "type": "array",
            "items": {
              "type": "string"
            },
            "scope": "resource",
            "default": [],
            "examples": [
              [
                "--external-sources"
              ]
            ]
          },
          "shellcheck.ignorePatterns": {
            "markdownDescription": "%config.ignorePatterns.markdownDescription%",
            "examples": [
              {
                "**/*.zsh": true,
                "**/*.zsh*": true,
                "**/.git/*.sh": true,
                "**/folder/**/*.sh": true
              }
            ],
            "type": "object",
            "scope": "resource",
            "additionalProperties": {
              "type": "boolean",
              "description": "%config.ignorePatterns.additionalProperties.description%"
            },
            "default": {
              "**/*.csh": true,
              "**/*.cshrc": true,
              "**/*.fish": true,
              "**/*.login": true,
              "**/*.logout": true,
              "**/*.tcsh": true,
              "**/*.tcshrc": true,
              "**/*.xonshrc": true,
              "**/*.xsh": true,
              "**/*.zsh": true,
              "**/*.zshrc": true,
              "**/zshrc": true,
              "**/*.zprofile": true,
              "**/zprofile": true,
              "**/*.zlogin": true,
              "**/zlogin": true,
              "**/*.zlogout": true,
              "**/zlogout": true,
              "**/*.zshenv": true,
              "**/zshenv": true,
              "**/*.zsh-theme": true
            }
          },
          "shellcheck.ignoreFileSchemes": {
            "description": "%config.ignoreFileSchemes.description%",
            "type": "array",
            "items": {
              "type": "string"
            },
            "scope": "application",
            "default": [
              "git",
              "gitfs",
              "output",
              "review",
              "pr",
              "githubpr",
              "gitpr",
              "githubcommit"
            ]
          },
          "shellcheck.useWorkspaceRootAsCwd": {
            "markdownDescription": "%config.useWorkspaceRootAsCwd.markdownDescription%",
            "type": "boolean",
            "scope": "resource",
            "default": false
          },
          "shellcheck.runTimeout": {
            "markdownDescription": "%config.runTimeout.markdownDescription%",
            "type": "number",
            "scope": "window",
            "minimum": 0,
            "maximum": 3600,
            "default": 0
          },
          "shellcheck.maxConcurrentRuns": {
            "markdownDescription": "%config.maxConcurrentRuns.markdownDescription%",
            "type": "integer",
            "minimum": 0,
            "scope": "window",
            "default": 0
          },
          "shellcheck.logLevel": {
            "description": "%config.logLevel.description%",
            "type": "string",
            "scope": "window",
            "enum": [
              "trace",
              "debug",
              "info",
              "warn",
              "error",
              "off"
            ],
            "default": "info"
          },
          "shellcheck.disableVersionCheck": {
            "markdownDescription": "%config.disableVersionCheck.markdownDescription%",
            "type": "boolean",
            "scope": "machine-overridable",
            "default": false
          }
        }
      },
      {
        "title": "%config.configFiles.title%",
        "properties": {
          "shellcheck.watchConfigFiles.workspace": {
            "markdownDescription": "%config.watchConfigFiles.workspace.markdownDescription%",
            "type": "boolean",
            "scope": "window",
            "default": false
          },
          "shellcheck.watchConfigFiles.user": {
            "markdownDescription": "%config.watchConfigFiles.user.markdownDescription%",
            "type": "boolean",
            "scope": "window",
            "default": false
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "whatsNew",
        "title": "%walkthrough.whatsNew.title%",
        "description": "%walkthrough.whatsNew.description%",
        "steps": [
          {
            "id": "statusBar",
            "title": "%walkthrough.whatsNew.step.statusBar.title%",
            "description": "%walkthrough.whatsNew.step.statusBar.description%",
            "media": {
              "svg": "resources/walkthrough/status-bar.svg",
              "altText": "%walkthrough.whatsNew.step.statusBar.altText%"
            }
          },
          {
            "id": "web",
            "title": "%walkthrough.whatsNew.step.web.title%",
            "description": "%walkthrough.whatsNew.step.web.description%",
            "media": {
              "svg": "resources/walkthrough/web.svg",
              "altText": "%walkthrough.whatsNew.step.web.altText%"
            }
          },
          {
            "id": "wasm",
            "title": "%walkthrough.whatsNew.step.wasm.title%",
            "description": "%walkthrough.whatsNew.step.wasm.description%",
            "media": {
              "svg": "resources/walkthrough/wasm.svg",
              "altText": "%walkthrough.whatsNew.step.wasm.altText%"
            },
            "when": "!isWeb"
          },
          {
            "id": "configFiles",
            "title": "%walkthrough.whatsNew.step.configFiles.title%",
            "description": "%walkthrough.whatsNew.step.configFiles.description%",
            "media": {
              "svg": "resources/walkthrough/config-files.svg",
              "altText": "%walkthrough.whatsNew.step.configFiles.altText%"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "prepare": "bindl",
    "check-types": "tsc --noEmit",
    "check-types:watch": "tsc --noEmit --watch",
    "build": "npm run check-types && node esbuild.js",
    "build:watch": "node esbuild.js --watch",
    "build:prod": "npm run check-types && node esbuild.js --production",
    "build:test": "tsc --project tsconfig.test.json",
    "build:icons": "node resources/build-icon-font.mjs",
    "build:test:web": "esbuild test/web/index.ts --bundle --format=cjs --platform=browser --target=es2022 --external:vscode --outfile=out/web-test/index.cjs",
    "build:test:watch": "tsc --project tsconfig.test.json --watch",
    "build:all": "run-p build build:test",
    "build:all:watch": "run-p check-types:watch build:watch build:test:watch",
    "vscode:prepublish": "npm run build:prod",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell": "cspell \"**\"",
    "l10n:export": "vscode-l10n-dev export --outDir ./l10n ./src",
    "l10n:check": "npm run l10n:export && git diff --exit-code -- l10n/bundle.l10n.json",
    "pretest": "npm run build:all",
    "test": "vscode-test",
    "test:web": "node test/web/run.mjs",
    "posttest": "npm run lint && npm run format:check && npm run spell && installed-check --ignore-dev",
    "release": "semantic-release"
  },
  "dependencies": {
    "@vscode-shellcheck/shellcheck-wasm": "0.3.0",
    "execa": "^10.0.1",
    "minimatch": "^10.2.6",
    "remeda": "^2.51.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@types/vscode": "~1.101.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "bindl": "^7.1.6",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cspell": "^10.3.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "installed-check": "^11.0.0",
    "mocha": "^12.0.3",
    "neostandard": "^0.13.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9",
    "semantic-release-stop-before-publish": "^2.0.0",
    "semantic-release-vsce": "^6.1.8",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "ttf2woff": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22"
  },
  "__metadata": {
    "id": "f95d8fff-f70a-4ae5-bb06-5c47ddbc8fc6",
    "publisherDisplayName": "Timon Wong",
    "publisherId": "04757770-dd50-443e-aae4-e1c7cf9c24f5"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true
  }
}
