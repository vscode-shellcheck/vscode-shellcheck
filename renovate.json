{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "rangeStrategy": "bump",
  "semanticCommits": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^bindl\\.config\\.ts$/"],
      "matchStrings": [
        "export const version = \\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\";"
      ],
      "depNameTemplate": "koalaman/shellcheck",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "The ShellCheck WebAssembly artifact is pinned by commit. WASM_SHA256 and WASM_SIZE in the same file describe the artifact at that commit and have to be updated along with it, otherwise scripts/fetch-wasm.mjs fails the build.",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts\\/fetch-wasm\\.mjs$/"],
      "matchStrings": [
        "export const GO_SHELLCHECK_COMMIT = \\\"(?<currentDigest>[0-9a-f]{40})\\\";"
      ],
      "depNameTemplate": "wasilibs/go-shellcheck",
      "packageNameTemplate": "https://github.com/wasilibs/go-shellcheck",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Automerge non-major dev updates",
      "matchDepTypes": ["devDependencies", "tools", "action", "uses-with"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchDepTypes": ["dependencies"],
      "semanticCommitType": "build"
    },
    {
      "matchDepTypes": ["devDependencies", "tools"],
      "semanticCommitType": "build",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "semanticCommitType": "build",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchDepTypes": ["action", "uses-with"],
      "semanticCommitType": "ci"
    },
    {
      "description": "Disable engine updates",
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "Disable minor updates for @types/vscode",
      "matchPackageNames": ["@types/vscode"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Disable major updates for @types/node",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
